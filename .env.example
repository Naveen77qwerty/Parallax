# Alpaca — paper trading only. Never set ALPACA_PAPER_TRADE=false in this project.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Google Gemini (catalyst gate + structure proposal agents — the two decisions
# with real veto/sizing power). Free-tier key from aistudio.google.com,
# no credit card required. gemini-2.5-flash free tier: 10 req/min, 250 req/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: comma-separated fallback list, tried in order whenever a model
# returns a quota/rate-limit error (HTTP 429 / RESOURCE_EXHAUSTED) — each
# free-tier model has its own separate quota. Any non-quota error still fails
# closed immediately, on whichever model hit it. Unset = just GEMINI_MODEL,
# identical to before this existed.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Featherless AI (hackathon technology partner) — open-source model used ONLY
# for the non-critical headline pre-digest (screen/headline_triage.py).
# OpenAI-compatible endpoint; $25/participant credit, pay-per-request.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Runtime
BARBELL_ENV=paper
BARBELL_DB_PATH=data/barbell.db
BARBELL_LOG_LEVEL=INFO

# Kept out of git. Copy to .env and fill in real paper-account values.
