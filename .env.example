# Alpaca — paper trading only. Never set ALPACA_PAPER_TRADE=false in this project.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic (catalyst gate + structure proposal agents — the two decisions
# with real veto/sizing power)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

# Featherless AI (hackathon technology partner) — open-source model used ONLY
# for the non-critical headline pre-digest (screen/headline_triage.py).
# OpenAI-compatible endpoint; $25/participant credit, pay-per-request.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Runtime
BARBELL_ENV=paper
BARBELL_DB_PATH=data/barbell.db
BARBELL_LOG_LEVEL=INFO

# Kept out of git. Copy to .env and fill in real paper-account values.
